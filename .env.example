# LOVENY Environment Variables Example
# Copy this file to .env and customize values as needed.

# Application Security & Debug
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=local-dev-secret-key-change-in-production

# Email Configuration (Gmail SMTP)
# Note: For Gmail, EMAIL_HOST_PASSWORD must be a 16-character Google App Password
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=help.hoxobil@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LOVENY Support <help.hoxobil@gmail.com>

# Database (PostgreSQL for Production, SQLite used if omitted)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Cloudinary (Optional media storage)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Payment Gateways (Optional)
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
